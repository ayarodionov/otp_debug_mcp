[35.964, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[48;5;255m\u001b[38;5;241m\u276f \u001b[38;5;16mshop@127.0.0.1 keeps getting slower and using more memory. Find out why, briefly.\u001b[39m                 \r\u001b[1C\u001b[1B\u001b[49m\u001b[K\r\u001b[1C\u001b[1B \u001b[38;5;241mCalled otp-debug \u001b[1m5\u001b[22m times \u001b[39m\u001b[K\r\u001b[2B\u001b[38;5;16m\u25cf\u001b[3G\u001b[39m\u001b[1mCause: \u001b[38;5;105mShop.PriceCache\u001b[39m (<0.107.0>) can't keep up with its mailbox.\u001b[70G\u001b[22mThe\u001b[74Gbacklog\u001b[82Gis\u001b[85Gboth\u001b[90Gthe\u001b[94Gmemory\r\u001b[1B  growth and the slowness.\u001b[K\r\u001b[2B \u001b[3G- \u001b[1mBacklog:\u001b[22m its mailbox held\u001b[31G1,317,034\u001b[41Gmessages\u001b[50Gand\u001b[54Gwas\u001b[58Ggrowing\u001b[66Gby\u001b[69Gabout\u001b[75G24,000\u001b[82Ga\u001b[84Gsecond,\u001b[92G51\u001b[95Gs\r\u001b[4C\u001b[1Bafter\u001b[11Gthe\u001b[15Gnode\u001b[20Gstarted.\u001b[29GA\u001b[31Gsecond\u001b[38Greading\u001b[46Ga\u001b[48Gmoment\u001b[55Glater\u001b[61Gshowed\u001b[68Gthe\u001b[72Gnode's\u001b[79Gtotal\u001b[85Gqueue\u001b[91Gup\u001b[94Ganother\r\u001b[4C\u001b[1B46,787\u001b[12Gin\u001b[15Gone\u001b[19Gsecond.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mMemory:\u001b[13G\u001b[22mthat\u001b[18Gone\u001b[22Gprocess\u001b[30Gholds\u001b[36Gabout\u001b[42G222\u001b[46GMB,\u001b[50Gnearly\u001b[57Gall\u001b[61Gof\u001b[64Gthe\u001b[68Gnode's\u001b[75Gmemory.\u001b[83GEverything\u001b[94Gelse\u001b[99Gis\r\u001b[4C\u001b[1Bhealthy:\u001b[14Gno\u001b[17Gb"]
[36.012, "o", "inary\u001b[24Gleak,\u001b[30GETS\u001b[34Gand\u001b[38Gprocess\u001b[46Gcount\u001b[52Gflat,\u001b[58Gschedulers\u001b[69Gidle.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWhy it is slow:\u001b[21G\u001b[22mit\u001b[24Gis\u001b[27Gsitting\u001b[35Gin\u001b[38G\u001b[38;5;105mProcess.sleep/1\u001b[39m,\u001b[55Gcalled\u001b[62Gfrom\u001b[67G\u001b[38;5;105mShop.PriceCache.handle_cast/2\r\u001b[4C\u001b[1B\u001b[39m(\u001b[38;5;105mexamples/elixir/src/shop.exs:12\u001b[39m),\u001b[40Gso\u001b[43Git\u001b[46Gsleeps\u001b[53Gwhile\u001b[59Ghandling\u001b[68Geach\u001b[73Gcast.\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mWho fills it:\u001b[19G\u001b[22ma\u001b[21Gsingle\u001b[28Gprocess,\u001b[37G<0.108.0>\u001b[47G(a\u001b[50Gbare\u001b[55Gspawned\u001b[63Gfunction),\u001b[74Gsends\u001b[80Gall\u001b[84Gof\u001b[87Git\u001b[90Gas\r\u001b[4C\u001b[1B\u001b[38;5;105m{:update, _, _}\u001b[21G\u001b[39mcasts.\u001b[28GBecause\u001b[36Gthey\u001b[41Gare\u001b[45Gcasts,\u001b[52Gnothing\u001b[60Gever\u001b[65Gslows\u001b[71Gthe\u001b[75Gsender\u001b[82Gdown.\r\u001b[2C\u001b[2BAnything\u001b[12Gthat\u001b[17Gcalls\u001b[23G\u001b[38;5;105mPriceCache\u001b[34G\u001b[39mwaits\u001b[40Gbehind\u001b[47Gthat\u001b[52Gbacklog,\u001b[61Gwhich\u001b[67Gis\u001b[70Gwhy\u001b[74Gthe\u001b[78Gnode\u001b[83Ggets\u001b[88Gslower\u001b[95Gthe\r\u001b[2C\u001b[1Blonger\u001b[10Git\u001b[13Gruns.\r\u001b[2C\u001b[2B\u001b[1mFix:\u001b[8G\u001b[22mtake\u001b[13Gthe\u001b[17Gsleep\u001b[23G(or\u001b[27Gwhatever\u001b[36Gslow\u001b[41Gwork\u001b[46Git\u001b[49Gstands\u001b["]
[36.013, "o", "56Gin\u001b[59Gfor)\u001b[64Gout\u001b[68Gof\u001b[71G\u001b[38;5;105mhandle_cast\u001b[39m,\u001b[84Gand\u001b[88Gmake\u001b[93Gthe\r\u001b[2C\u001b[1Bsender\u001b[10Gwait\u001b[15G\u2014\u001b[17Ga\u001b[19G\u001b[38;5;105mcall\u001b[24G\u001b[39minstead\u001b[32Gof\u001b[35Ga\u001b[37G\u001b[38;5;105mcast\u001b[39m,\u001b[43Gor\u001b[46Gacknowledged\u001b[59Gbatches.\r\u001b[2C\u001b[2BNot\u001b[7Gverified:\u001b[17GI\u001b[19Gdid\u001b[23Gnot\u001b[27Gread\u001b[32Gthe\u001b[36Gcode\u001b[41Gat\u001b[44G\u001b[38;5;105mshop.exs:12\u001b[39m.\u001b[57GThe\u001b[61Gmodule\u001b[68Gwas\u001b[72Gcompiled\u001b[81Gin\u001b[84Gmemory\u001b[91Gfrom\u001b[96Ga\r\u001b[2C\u001b[1Bscript,\u001b[11Gso\u001b[14Gthe\u001b[18Gnode\u001b[23Ghas\u001b[27Gno\u001b[30G\u001b[38;5;105m.beam\u001b[36G\u001b[39mto\u001b[39Gshow;\u001b[45Gthe\u001b[49Gsleep\u001b[55Gis\u001b[58Gtaken\u001b[64Gfrom\u001b[69Gthe\u001b[73Gprocess's\u001b[83Gstack,\u001b[90Gnot\u001b[94Gthe\r\u001b[2C\u001b[1Bsource.\r\u001b[15C\u001b[2B\u001b[38;5;241m8\u001b[23G1.1k tokens \u00b7 \u001b[38;5;249mthinking with medium e\u001b[60Gfort\u001b[38;5;241m)\u001b[39m\u001b[34;1H\u001b[32;3H\u001b[?25h\u001b]0;\u2733 shop@127.0.0.1 slowdown and memory growth\u0007\u001b[?25l\u001b[H\r\u001b[28B\u001b[38;5;241m\u273b\u001b[3GWorked for 28s \u00b7 done \u001b[26G0:47 AM\u001b[39m\u001b[K\r\u001b[3B\u276f \r\u001b[38C\u001b[2B\u001b[K\u001b[34;1H\u001b[32;3H\u001b[?25h"]
